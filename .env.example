# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=你的R2账号ID
R2_ACCESS_KEY_ID=你的R2_Access_Key
R2_SECRET_ACCESS_KEY=你的R2_Secret_Key
R2_BUCKET=cundrop
# 可选：默认 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# ---- 应用 ----
# 登录密码（首次部署时务必修改）
APP_PASSWORD=change-me-please
# Flask session 密钥，请换成随机长字符串
SECRET_KEY=change-me-to-a-random-string
# 可选：监听端口
# PORT=5000
