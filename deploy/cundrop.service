# CunDrop systemd 服务示例
# 放到服务器 /etc/systemd/system/cundrop.service，然后：
#   sudo systemctl daemon-reload && sudo systemctl enable --now cundrop
#
# 注意：把 /opt/cundrop 换成你的实际部署路径；
# .env 文件放在该目录下（不要进 Git）。

[Unit]
Description=CunDrop - personal R2 drive
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/cundrop
EnvironmentFile=/opt/cundrop/.env
ExecStart=/opt/cundrop/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
